# --- secrets: never commit -------------------------------------------------
# The TT-654 seed token file holds live secrets. .mailpit/ is runtime scratch
# (pid + log) — it no longer holds credentials, since the catcher runs with
# --smtp-auth-accept-any and has none, but there is no reason to commit it.
.mailpit/
.tt654-seed.env
*.env
!*.env.example

# --- run artefacts ---------------------------------------------------------
# .auth/ holds saved browser storage state — live session cookies. Treat it as
# credentials, never commit it.
.auth/
.playwright-cli/
*-failure.png
test-results/
results.xml
baseline.xml
quality/.last-check.json
quality/.last-check.txt

# --- node ------------------------------------------------------------------
node_modules/
npm-debug.log*
package-lock.json.bak

# --- os --------------------------------------------------------------------
.DS_Store
Thumbs.db
