# Credentials for reproducing a CI e2e failure locally, used by
# .claude/tools/e2e-local.sh in the model repo.
#
# Copy to .e2e-autofix.env (gitignored by the *.env rule) and fill in the SAME values
# as the GitHub Actions secrets on JoshNorris-Titan/titan-time-e2e. If these drift from
# the secrets, a local repro tests a different environment than CI did and the loop will
# chase phantoms.
#
#   cp tests/.e2e-autofix.env.example tests/.e2e-autofix.env

# Must match the TT_BASE_URL secret exactly, no trailing slash.
TT_BASE_URL=https://titantime100-development.mendixcloud.com

TT_ADMIN_USER=
TT_ADMIN_PASS=

# Password for the e2e_* role accounts.
TT_ROLE_PASS=

# Pipe-separated consultant FullNames the bookend clear scripts are allowed to reset.
# There is NO TT_E2E_CONSULTANTS secret on the repo, so in CI this is empty and
# lib/_testdata.sh falls back to its default. Leave it blank to match CI exactly.
TT_E2E_CONSULTANTS=

# Needed by verify-unittests to reach the UnitTesting remote API.
TT_UNITTEST_PASS=
