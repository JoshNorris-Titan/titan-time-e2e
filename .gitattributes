# Shell scripts MUST be stored and checked out with LF endings.
# The suite is authored on Windows but runs on ubuntu-latest in CI, and a .sh
# file with CRLF fails there with the classic "$'\r': command not found".
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

*.png   binary

# The pw-trace profiling shim is deliberately EXTENSIONLESS: to shadow the real
# binary on PATH it must be named exactly `playwright-cli`. That puts it outside
# the *.sh rule above, so without this line it checks out on ubuntu-latest with
# CRLF and dies as "$'\r': command not found" - the very failure that rule exists
# to prevent.
tools/pw-trace/playwright-cli   text eol=lf
